{
  "name": "document-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Shared document framework: one block model, Word output, client-side layout to PDF and page pictures, and Word template filling. Runs entirely in the browser.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./docx": {
      "types": "./dist/types/docx/index.d.ts",
      "import": "./dist/docx.js"
    },
    "./layout": {
      "types": "./dist/types/layout/index.d.ts",
      "import": "./dist/layout.js"
    },
    "./pdf-preview": {
      "types": "./dist/types/layout/pdfSource.d.ts",
      "import": "./dist/pdf-preview.js"
    },
    "./template": {
      "types": "./dist/types/template/index.d.ts",
      "import": "./dist/template.js"
    },
    "./recipe": {
      "types": "./dist/types/recipe/index.d.ts",
      "import": "./dist/recipe.js"
    },
    "./ream": {
      "types": "./dist/types/ream/index.d.ts",
      "import": "./dist/ream.js"
    },
    "./fonts/*": "./fonts/*",
    "./package.json": "./package.json",
    "./diagrams": {
      "types": "./dist/types/diagrams/index.d.ts",
      "import": "./dist/diagrams.js"
    },
    "./diagrams/d3": {
      "types": "./dist/types/diagrams/d3.d.ts",
      "import": "./dist/diagrams-d3.js"
    }
  },
  "files": [
    "dist",
    "fonts",
    "LICENSE",
    "NOTICE-*.md",
    "README.md",
    "examples/diagrams",
    "docs/diagrams.md"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && tsc -p src/template/tsconfig.build.json && tsc -p src/recipe/tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p src/template/tsconfig.json --noEmit && tsc -p src/recipe/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit && tsc -p tsconfig.integration.json --noEmit",
    "test": "vitest run",
    "test:browser": "node tests/browser/run.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "d3-hierarchy": "2.0.0",
    "d3-scale": "3.3.0",
    "d3-shape": "2.1.0",
    "docx": "^9.15.4",
    "fast-xml-parser": "5.7.3",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": ">=20.11.0",
    "playwright-core": ">=1.56.0",
    "typescript": ">=5.4.0",
    "vite": "^8.0.0",
    "vitest": ">=4.1.0"
  }
}
